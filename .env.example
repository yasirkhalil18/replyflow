# ReplyFlow Environment Configuration

# Server Port
PORT=3000

# ─── Instagram / Facebook OAuth Configuration ───
# Get these from: https://developers.facebook.com/apps/
# 1. Create a Facebook App (type: Business)
# 2. Add "Instagram" product to your app
# 3. Go to Instagram > Basic Display or Instagram > API Setup
# 4. Copy App ID and App Secret below
INSTAGRAM_APP_ID=YOUR_INSTAGRAM_APP_ID_HERE
INSTAGRAM_APP_SECRET=YOUR_INSTAGRAM_APP_SECRET_HERE

# This is where Instagram redirects after user authorizes
# For local testing: http://localhost:3000/api/instagram/callback
# For production: https://yourdomain.com/api/instagram/callback
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# OAuth Scopes (comma-separated, no spaces between scopes)
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments

# Your app's origin URL (used for postMessage security)
REPLYFLOW_ORIGIN=http://localhost:3000

# ─── Token Encryption Key ───
# Generate a random 32-char hex string for encrypting access tokens
# Example: openssl rand -hex 16
TOKEN_ENCRYPTION_KEY=your_random_32_character_hex_key

# ─── Figma Access Tokens (Keep private, do not commit to Git) ───
FIGMA_PERSONAL_ACCESS_TOKEN=YOUR_FIGMA_PERSONAL_ACCESS_TOKEN_HERE
FIGMA_DESIGN_FILE_KEY=YOUR_FIGMA_DESIGN_FILE_KEY_HERE

# Security Session Secret
SESSION_SECRET=super_secret_session_key_102948

# ─── Production MySQL / MariaDB Database Configuration ───
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replyflow_db_user
DB_PASSWORD=YOUR_SECURE_MYSQL_PASSWORD
DB_NAME=replyflow_db

# ─── System Admin Initial Credentials ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YOUR_INITIAL_SECURE_ADMIN_PASSWORD

